# ==============================================================================
# Aurelian International - Environment Configuration
# All secret credentials MUST remain in this server-side file and NEVER in frontend code.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. GOOGLE APPS SCRIPT WEB APP INTEGRATION (Primary Live Sheet & Mailer)
# ------------------------------------------------------------------------------
# Deployed Web App URL from Google Apps Script (see docs/ENQUIRY_SETUP.md)
WEB_APP_URL="https://script.google.com/macros/s/AKfycb.../exec"
VITE_APPS_SCRIPT_URL="PASTE_YOUR_EXEC_URL_HERE"

# Shared secret matching the 'SECRET' property set in Google Apps Script Project Settings
ENQUIRY_SECRET="your-32-char-random-secret-token"

# ------------------------------------------------------------------------------
# 2. OWNER NOTIFICATION EMAIL (Fallback / Direct SMTP)
# ------------------------------------------------------------------------------
# Email address(es) where export quotation requests are sent.
OWNER_EMAIL="shivamkareliya01@gmail.com"

# Sender header displayed to clients and owners
MAIL_FROM="\"Aurelian International Trade Desk\" <shivamkareliya01@gmail.com>"

# ------------------------------------------------------------------------------
# 3. DIRECT SMTP CONFIGURATION (Optional fallback if not using Apps Script)
# ------------------------------------------------------------------------------
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_USER="shivamkareliya01@gmail.com"
SMTP_PASS="your-16-character-app-password-here"

# ------------------------------------------------------------------------------
# 4. ALTERNATIVE: RESEND API KEY (Optional fallback)
# ------------------------------------------------------------------------------
RESEND_API_KEY=""

# ------------------------------------------------------------------------------
# 5. ANTI-SPAM: CLOUDFLARE TURNSTILE (Optional)
# ------------------------------------------------------------------------------
# Secret key from Cloudflare Turnstile dashboard
TURNSTILE_SECRET_KEY=""
# Public site key for frontend widget
VITE_TURNSTILE_SITE_KEY=""

# ------------------------------------------------------------------------------
# 6. MASTER EXCEL SPREADSHEET PATH (Optional)
# ------------------------------------------------------------------------------
# Leave empty to use default 'Aurelian_Enquiries_Master.xlsx' in project root.
# You can set a custom path (e.g. on Desktop) where enquiries should be appended:
# MASTER_EXCEL_PATH="C:/Users/ASUS/Desktop/Aurelian_Enquiries_Master.xlsx"
MASTER_EXCEL_PATH=""

# ------------------------------------------------------------------------------
# 7. TESTING / LOCAL DEV MODE
# ------------------------------------------------------------------------------
# Set to 'true' in development to mock Apps Script & email delivery if credentials are empty.
TEST_MODE="true"
