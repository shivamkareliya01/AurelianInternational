# ==============================================================================
# Aurelian International - Environment Configuration Template
# All secret credentials MUST remain in this server-side file and NEVER in frontend code.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. GOOGLE APPS SCRIPT WEB APP INTEGRATION (Live Google Sheet & Mailer)
# ------------------------------------------------------------------------------
# Deployed Web App URL from Google Apps Script (see docs/ENQUIRY_SETUP.md)
WEB_APP_URL="https://script.google.com/macros/s/AKfycb.../exec"
GOOGLE_SHEET_URL="https://docs.google.com/spreadsheets/d/YOUR_SHEET_ID_HERE/edit"

# Shared secret matching the 'SECRET' property set in Google Apps Script Project Settings
ENQUIRY_SECRET="your-32-char-random-secret-token"

# ------------------------------------------------------------------------------
# 2. OWNER NOTIFICATION EMAIL
# ------------------------------------------------------------------------------
# Email address(es) where export quotation requests are sent (comma-separated supported)
OWNER_EMAIL="export@aurelianinternational.com"

# Sender header displayed to clients and owners
MAIL_FROM="\"Aurelian International Trade Desk\" <noreply@aurelianinternational.com>"

# ------------------------------------------------------------------------------
# 3. DIRECT SMTP CONFIGURATION (Gmail / Custom Domain)
# ------------------------------------------------------------------------------
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=465
SMTP_USER="your-email@gmail.com"
SMTP_PASS="your-16-character-app-password-here"

# ------------------------------------------------------------------------------
# 4. TESTING / LOCAL DEV MODE
# ------------------------------------------------------------------------------
# Set to 'false' in production, or 'true' in development
TEST_MODE="false"
